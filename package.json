{
  "name": "repl-live",
  "version": "1.0.0",
  "description": "Node REPL with automatic context re-require on file change",
  "type": "module",
  "main": "dist/repl-live.js",
  "types": "dist/repl-live.d.ts",
  "exports": {
    ".": {
      "types": "./dist/repl-live.d.ts",
      "default": "./dist/repl-live.js"
    }
  },
  "files": [
    "dist/repl-live.js",
    "dist/repl-live.js.map",
    "dist/repl-live.d.ts",
    "dist/repl-live.d.ts.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/repl-live.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/repl-live.git"
  },
  "keywords": [
    "repl",
    "nodemon",
    "autoreload",
    "require",
    "live",
    "watch",
    "livereload",
    "hot-reload"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cinderblock/repl-live/issues"
  },
  "homepage": "https://github.com/cinderblock/repl-live#readme",
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  }
}
